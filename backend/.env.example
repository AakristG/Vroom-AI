# Django
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_DEBUG=true
# Include your ngrok/tunnel hostname when Retell Custom LLM reaches this backend publicly.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
AUTH_TOKEN_TTL_SECONDS=43200

# CORS — frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# NVIDIA NIM (Nemotron). Server-side only.
# Cloud path (default): chat + embeddings via integrate.api.nvidia.com
NVIDIA_NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Embeddings stay on the cloud Retriever NIM even if chat points at a local Brev vLLM server.
NIM_EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NIM_EMBED_TYPE=float
NIM_TEMPERATURE=0.2
NIM_ENABLE_THINKING=false
# Keep false on cloud. Local Brev vLLM can set true when started with
# --enable-auto-tool-choice --tool-call-parser qwen3_coder.
NIM_TOOL_CALLING=false
# Optional local GPU (Brev instance "nemotron", vLLM on :5000 as model "nemotron"):
#   brev port-forward nemotron --port 5000:5000
#   NIM_BASE_URL=http://127.0.0.1:5000/v1
#   NIM_MODEL=nemotron
# Leave NIM_EMBED_* on the cloud URLs above when using local chat.

# NHTSA public APIs — no API key.
NHTSA_VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api
NHTSA_DATA_BASE_URL=https://api.nhtsa.gov

# EPA FuelEconomy.gov — public, no API key. MPG and tested configurations only.
EPA_FUELECONOMY_BASE_URL=https://www.fueleconomy.gov/ws/rest

# Retell / Twilio (optional voice and SMS)
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=

# Public URLs used in continuation links and webhook docs
APP_BASE_URL=http://localhost:5173
# Public HTTPS origin (ngrok etc.). Its hostname is also added to ALLOWED_HOSTS automatically.
PUBLIC_WEBHOOK_BASE_URL=http://127.0.0.1:8000

# Transactional email (Resend). Sent when a specialist request is saved after two confirmations.
# Pending requests get an acknowledgment that clearly says they are not confirmed bookings.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=aakrist.godar.1@gmail.com
# Local demo only (requires DJANGO_DEBUG=true). Routes simulated C### customer notices here.
DEMO_NOTIFICATION_EMAIL_OVERRIDE=

# SpacetimeDB (optional realtime fan-out; Django remains the account source of truth)
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_MODULE_NAME=toyota-nextmove
SPACETIMEDB_TOKEN=
