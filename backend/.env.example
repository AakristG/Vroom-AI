# Django
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - the frontend's dev URL
CORS_ALLOWED_ORIGINS=http://localhost:5173

# NVIDIA NIM (Nemotron). Also accepted as NVIDIA_API_KEY by the FastAPI app.
NVIDIA_NIM_API_KEY=
NVIDIA_API_KEY=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
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Keep false for voice: thinking adds latency and can leave no spoken answer.
NIM_ENABLE_THINKING=false
# Set true only if the NIM container was started with tool calling enabled
# (--enable-auto-tool-choice and a tool-call parser). Otherwise the assistant
# plans backend tools itself and grounds Nemotron in their results.
NIM_TOOL_CALLING=false

# Retell AI - https://dashboard.retellai.com
RETELL_API_KEY=
RETELL_AGENT_ID=
# Number Retell uses to place an outbound call to the customer.
RETELL_FROM_NUMBER=

# Twilio - optional text confirmation for a scheduled representative call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# CarsXE - vehicle specs, images, and VIN market value. https://api.carsxe.com
# Server-side only; never put this in frontend/.env. Without it, /vehicles uses
# the labeled demo catalog in apps/vehicles/demo_catalog.json.
CARSXE_API_KEY=e2k01wcr2_clfyd2wwv_svyj4jgyi
CARSXE_BASE_URL=https://api.carsxe.com
# Responses are cached on disk in backend/.cache/carsxe (default 7 days).
CARSXE_CACHE_SECONDS=604800

# SpacetimeDB
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_MODULE_NAME=toyota-fs-dev
SPACETIMEDB_DB_NAME=tfs_mobility
SPACETIMEDB_TOKEN=
