# Django
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - the frontend's dev URL
CORS_ALLOWED_ORIGINS=http://localhost:5173

# NVIDIA NIM (Nemotron models)
# Option A - our Brev GPU (run `brev port-forward nemotron --port 8001:8000` first, no key needed):
#   NVIDIA_NIM_API_KEY=not-needed
#   NIM_BASE_URL=http://localhost:8001/v1
#   NIM_MODEL=nvidia/nemotron-3.5-lightning
# Option B - NVIDIA hosted API (key from https://build.nvidia.com):
NVIDIA_NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Keep false for voice: thinking adds latency and can leave no spoken answer.
NIM_ENABLE_THINKING=false

# Retell AI - https://dashboard.retellai.com
# Must be an API key that has the "webhook" badge in the dashboard - it's also used to verify
# the X-Retell-Signature header on incoming webhooks (see apps/voice/webhooks.py).
RETELL_API_KEY=
RETELL_AGENT_ID=

# SpacetimeDB - https://spacetimedb.com/docs/http/database
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_MODULE_NAME=toyota-fs-dev
SPACETIMEDB_TOKEN=
