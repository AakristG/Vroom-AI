# Browser-visible API origin. Never put NVIDIA or other API secrets here.
VITE_API_BASE_URL=http://localhost:8000

# Optional public-key fallback for Retell web calls. Prefer server mint via /api/voice/web-call/.
# VITE_RETELL_PUBLIC_KEY=
# VITE_RETELL_AGENT_ID=

# SpacetimeDB (live call transcripts and AI next moves). Defaults shown.
VITE_SPACETIMEDB_URL=http://127.0.0.1:3000
VITE_SPACETIMEDB_MODULE_NAME=vroom-live
